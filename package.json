{
  "name": "notka",
  "private": true,
  "version": "1.1.0-beta.1",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "description": "A simple markdown editor",
  "author": "Notka",
  "main": "out/main.cjs",
  "scripts": {
    "dev": "pnpm build:updater && node scripts/dev.mjs",
    "build:updater": "node scripts/build-updater.mjs",
    "build:main": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=out --out-extension:.js=.cjs",
    "build": "pnpm build:updater && tsc --noEmit && vite build && pnpm build:main",
    "dist": "pnpm build && electron-builder --win dir",
    "icon": "electron scripts/icon.cjs",
    "release": "node scripts/release.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/kit": "^7.22.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsdom": "^30.1.3",
    "lucide-react": "^1.55.0",
    "marked": "^18.1.1",
    "marked-gfm-heading-id": "^4.1.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remark-frontmatter": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.notka.app",
    "productName": "Notka",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/updater.exe",
        "to": "updater.exe"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "resources/md-file.ico",
        "to": "md-file.ico"
      }
    ],
    "win": {
      "target": "dir",
      "executableName": "notka",
      "icon": "resources/icon.ico"
    },
    "asar": true,
    "electronDist": "node_modules/electron/dist"
  }
}
